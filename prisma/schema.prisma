generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SequelizeMeta {
  name String @id @db.VarChar(255)
}

model activity_logs {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(255)
  tenantId  String   @db.VarChar(255)
  userId    String   @db.VarChar(255)
  date      DateTime @db.Date
  messages  BigInt   @default(0)
  voiceTime BigInt   @default(0)
  media     BigInt   @default(0)
  emojis    BigInt   @default(0)
  reactions BigInt   @default(0)
  links     BigInt   @default(0)
  commands  BigInt   @default(0)

  @@unique([guildId, userId, date, tenantId], map: "activity_logs_guild_user_date_tenant_unique")
  @@index([guildId, date, tenantId], map: "activity_logs_guild_date_tenant_idx")
}

model activity_stats {
  id             Int      @id @default(autoincrement())
  guildId        String   @db.VarChar(255)
  tenantId       String   @db.VarChar(255)
  userId         String   @db.VarChar(255)
  totalMessages  BigInt   @default(0)
  totalVoiceTime BigInt   @default(0)
  totalMedia     BigInt   @default(0)
  totalEmojis    BigInt   @default(0)
  totalReactions BigInt   @default(0)
  totalLinks     BigInt   @default(0)
  totalCommands  BigInt   @default(0)
  createdAt      DateTime @db.Timestamptz(6)
  updatedAt      DateTime @db.Timestamptz(6)

  @@unique([guildId, userId, tenantId], map: "activity_stats_guild_user_tenant_unique")
  @@index([guildId, totalMessages, tenantId], map: "activity_stats_guild_messages_tenant_idx")
  @@index([guildId, totalVoiceTime, tenantId], map: "activity_stats_guild_voice_tenant_idx")
}

model user_channel_logs {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(255)
  tenantId  String   @db.VarChar(255)
  userId    String   @db.VarChar(255)
  channelId String   @db.VarChar(255)
  date      DateTime @db.Date
  messages  BigInt   @default(0)

  @@unique([guildId, userId, channelId, date, tenantId], map: "user_channel_logs_unique")
  @@index([guildId, channelId, date, tenantId], map: "user_channel_logs_idx")
}

model server_activity_logs {
  id        Int      @id @default(autoincrement())
