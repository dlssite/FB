  userId          String    @db.VarChar(255)
  guildId         String    @db.VarChar(255)
  tenantId        String    @db.VarChar(255)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastClaimedAt   DateTime? @db.Timestamptz(6)
  freezesUsed     Int       @default(0)

  @@unique([userId, guildId, tenantId])
  @@index([guildId, currentStreak(sort: Desc), tenantId])
}

model counting_settings {
  guildId           String   @db.VarChar(255)
  tenantId          String   @db.VarChar(255)
  channelId         String?  @db.VarChar(255)
  currentCount      Int      @default(0)
  highestCount      Int      @default(0)
  lastUserId        String?  @db.VarChar(255)
  topRoleId         String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, tenantId])
}

model counting_users {
  userId          String   @db.VarChar(255)
  guildId         String   @db.VarChar(255)
  tenantId        String   @db.VarChar(255)
  totalCounts     Int      @default(0)
  ruinedCounts    Int      @default(0)
  savesUsed       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, guildId, tenantId])
  @@index([guildId, totalCounts(sort: Desc), tenantId])
  @@index([guildId, ruinedCounts(sort: Desc), tenantId])
}

// --- SYMPHONY MUSIC ENGINE ---

model music_settings {
  guildId   String   @db.VarChar(255)
  tenantId  String   @db.VarChar(255)
  isLocked  Boolean? @default(false)
  autoResume Boolean? @default(true)
  channelId String?  @db.VarChar(255)
  djRoleId  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, tenantId])
}

model music_user_stats {
  userId          String   @db.VarChar(255)
  guildId         String   @db.VarChar(255)
  tenantId        String   @db.VarChar(255)
  totalListenTime BigInt   @default(0)
  tracksRequested Int      @default(0)
  xpEarned        BigInt   @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([userId, guildId, tenantId])
}

model music_playlists {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(255)
  guildId   String   @db.VarChar(255)
  tenantId  String   @db.VarChar(255)
  name      String   @db.VarChar(255)
  tracks    Json     @db.Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId, tenantId], map: "music_playlists_userId_tenantId")
}

// --- COGNITIVE ENGINE (AI) ---

model ai_settings {
  guildId         String   @db.VarChar(255)
  tenantId        String   @db.VarChar(255)
  enabled         Boolean  @default(true)
  boundChannels   Json?    @default("[]") @db.Json // Array of channel IDs
  persona         String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, tenantId])
}

model ai_memories {
  id         Int      @id @default(autoincrement())
  tenantId   String   @db.VarChar(255)
  guildId    String   @db.VarChar(255)
  userId     String   @db.VarChar(255)
  factType   String   @db.VarChar(255) // "preference", "relationship", "history"
  factKey    String   @db.VarChar(255) // e.g. "music.genre"
  factValue  String
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId, tenantId])
  @@index([guildId, tenantId])
}

// --- PROFILE SYSTEM MODULE ---

model user_profiles {
  userId          String   @db.VarChar(255)
  tenantId        String   @db.VarChar(255)
  bio             String?  @db.VarChar(255)
  adminTitle      String?  @db.VarChar(255)
  customColor     String?  @db.VarChar(10)
  customBanner    String?  @db.VarChar(255)
  privacyMode     Boolean  @default(false)
  unlockedColor   Boolean  @default(false)
  unlockedBanner  Boolean  @default(false)
  unlockedPrivacy Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @db.Timestamptz(6)

  @@id([userId, tenantId])
  @@index([userId, tenantId])
}
